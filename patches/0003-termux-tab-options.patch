+++ b/src/client/shell/touch.rs
@@ -0,0 +1,186 @@
+use super::*;
+use crossterm::event::{MouseButton, MouseEvent, MouseEventKind};
+use std::time::{Duration, Instant};
+
+const DOUBLE_TAP_WINDOW: Duration = Duration::from_millis(300);
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct TouchTarget {
+    item: ClientMobileTarget,
+    boot_id: String,
+    switcher: bool,
+}
+
+pub(super) struct TouchPress {
+    target: TouchTarget,
+    down: MouseEvent,
+    up: Option<MouseEvent>,
+    pub(super) deadline: Instant,
+}
+
+impl ClientShellState {
+    fn touch_target(&self, mouse: MouseEvent) -> Option<TouchTarget> {
+        if !self.config.touch_context_menus
+            || !self.config.mouse_capture
+            || !mouse.modifiers.is_empty()
+            || self.overlay.is_some()
+            || self.popup_terminal_id.is_some()
+            || self.popup_pending
+            || self.replaying_url_click
+            || self.host_mouse_pixels.is_some()
+        {
+            return None;
+        }
+        let point = (mouse.column, mouse.row);
+        let switcher = self.mobile_layout_active() && self.mode == ClientShellMode::Navigate;
+        let item = if switcher {
+            self.hits.mobile_targets.iter().find_map(|(rect, target)| {
+                if !super::contains(*rect, point) {
+                    return None;
+                }
+                match target {
+                    ClientMobileTarget::Tab { endpoint_id, .. }
+                    | ClientMobileTarget::Agent { endpoint_id, .. }
+                        if *endpoint_id == self.active_endpoint_id =>
+                    {
+                        Some(target.clone())
+                    }
+                    _ => None,
+                }
+            })?
+        } else if matches!(
+            self.mode,
+            ClientShellMode::Terminal | ClientShellMode::Resize
+        ) {
+            if let Some((_, tab_id)) = self
+                .hits
+                .tabs
+                .iter()
+                .find(|(rect, _)| super::contains(*rect, point))
+            {
+                ClientMobileTarget::Tab {
+                    endpoint_id: self.active_endpoint_id.clone(),
+                    tab_id: tab_id.clone(),
+                }
+            } else {
+                // Scrollbars and split dividers retain their normal drag/click behavior.
+                if self
+                    .hits
+                    .pane_splits
+                    .iter()
+                    .any(|hit| super::contains(hit.hit_rect, point))
+                {
+                    return None;
+                }
+                let hit = self
+                    .hits
+                    .panes
+                    .iter()
+                    .find(|hit| super::contains(hit.rect, point))?;
+                if hit
+                    .scrollbar_rect
+                    .is_some_and(|rect| super::contains(rect, point))
+                {
+                    return None;
+                }
+                ClientMobileTarget::Agent {
+                    endpoint_id: self.active_endpoint_id.clone(),
+                    pane_id: hit.pane_id.clone(),
+                }
+            }
+        } else {
+            return None;
+        };
+        Some(TouchTarget {
+            item,
+            boot_id: self.snapshot.as_ref()?.boot_id.clone(),
+            switcher,
+        })
+    }
+
+    pub(super) fn flush_touch_press(&mut self, outcome: &mut ClientShellInput) {
+        let Some(press) = self.touch_press.take() else {
+            return;
+        };
+        // Never replay a delayed click into a different endpoint, layout, or dialog.
+        if self.touch_target(press.down).as_ref() != Some(&press.target) {
+            return;
+        }
+        self.handle_mouse_direct(press.down, outcome);
+        if let Some(up) = press.up {
+            self.handle_mouse_direct(up, outcome);
+        }
+        self.reconcile_input_source();
+    }
+
+    pub(crate) fn tick_touch(&mut self, now: Instant, outcome: &mut ClientShellInput) {
+        if self
+            .touch_press
+            .as_ref()
+            .is_some_and(|press| now >= press.deadline)
+        {
+            self.flush_touch_press(outcome);
+        }
+    }
+
+    pub(super) fn handle_mouse(&mut self, mut mouse: MouseEvent, outcome: &mut ClientShellInput) {
+        let now = Instant::now();
+        self.tick_touch(now, outcome);
+        // Complete the synthesized right-button gesture, including pane passthrough.
+        if self.touch_right_button {
+            match mouse.kind {
+                MouseEventKind::Up(MouseButton::Left) => {
+                    self.touch_right_button = false;
+                    mouse.kind = MouseEventKind::Up(MouseButton::Right);
+                }
+                MouseEventKind::Drag(MouseButton::Left) => {
+                    mouse.kind = MouseEventKind::Drag(MouseButton::Right);
+                }
+                MouseEventKind::Down(_) => self.touch_right_button = false,
+                _ => {}
+            }
+            self.handle_mouse_direct(mouse, outcome);
+            return;
+        }
+        if let Some(press) = self.touch_press.as_ref() {
+            let nearby = press.down.column.abs_diff(mouse.column) <= 1
+                && press.down.row.abs_diff(mouse.row) <= 1;
+            let same_target = self.touch_target(mouse).as_ref() == Some(&press.target);
+            if mouse.kind == MouseEventKind::Up(MouseButton::Left)
+                && press.up.is_none()
+                && nearby
+                && same_target
+            {
+                let press = self.touch_press.as_mut().expect("pending press");
+                press.up = Some(mouse);
+                press.deadline = now + DOUBLE_TAP_WINDOW;
+                return;
+            }
+            if mouse.kind == MouseEventKind::Down(MouseButton::Left)
+                && press.up.is_some()
+                && nearby
+                && same_target
+            {
+                self.touch_press = None;
+                self.touch_right_button = true;
+                mouse.kind = MouseEventKind::Down(MouseButton::Right);
+                self.handle_mouse_direct(mouse, outcome);
+                return;
+            }
+            // A drag, scroll, different target, or modifier ends the tap sequence.
+            self.flush_touch_press(outcome);
+        }
+        if mouse.kind == MouseEventKind::Down(MouseButton::Left) {
+            if let Some(target) = self.touch_target(mouse) {
+                self.touch_press = Some(TouchPress {
+                    target,
+                    down: mouse,
+                    up: None,
+                    deadline: now + DOUBLE_TAP_WINDOW,
+                });
+                return;
+            }
+        }
+        self.handle_mouse_direct(mouse, outcome);
+    }
+}
