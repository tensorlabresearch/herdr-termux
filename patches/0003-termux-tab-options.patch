+}
+
+#[test]
+fn timeout_modifiers_and_disabled_capture_do_not_open_touch_menus() {
+    let mut state = touch_state(106);
+    let rect = state.hits.tabs[0].0;
+    tap(&mut state, rect);
+    finish_single(&mut state);
+    tap(&mut state, rect);
+    finish_single(&mut state);
+    assert!(state.overlay.is_none());
+    state.config.mouse_capture = false;
+    tap(&mut state, rect);
+    tap(&mut state, rect);
+    assert!(state.overlay.is_none() && state.touch_press.is_none());
+    state.config.mouse_capture = true;
+    for _ in 0..2 {
+        for kind in [
+            MouseEventKind::Down(MouseButton::Left),
+            MouseEventKind::Up(MouseButton::Left),
+        ] {
+            let RawInputEvent::Mouse(mut mouse) = pointer(kind, rect) else {
+                unreachable!()
+            };
+            mouse.modifiers = KeyModifiers::SHIFT;
+            state.handle_raw_events(vec![RawInputEvent::Mouse(mouse)]);
+        }
+    }
+    assert!(state.overlay.is_none() && state.touch_press.is_none());
+}
