+use super::*;
+
+fn touch_state(cols: u16) -> ClientShellState {
+    let mut config = ClientShellConfig::from_config(&Config::default());
+    config.touch_context_menus = true;
+    let mut state = ClientShellState::new(config);
+    state.set_snapshot(Box::new(snapshot()));
+    state.set_pane_surface(surface());
+    state.compose(cols, 20).expect("touch layout");
+    state
+}
+
+fn pointer(kind: MouseEventKind, rect: Rect) -> RawInputEvent {
+    RawInputEvent::Mouse(MouseEvent {
+        kind,
+        column: rect.x,
+        row: rect.y,
+        modifiers: KeyModifiers::empty(),
+    })
+}
+
+fn tap(state: &mut ClientShellState, rect: Rect) -> ClientShellInput {
+    // Stock Termux sends both reports together when the finger lifts.
+    state.handle_raw_events(vec![
+        pointer(MouseEventKind::Down(MouseButton::Left), rect),
+        pointer(MouseEventKind::Up(MouseButton::Left), rect),
+    ])
+}
+
+fn finish_single(state: &mut ClientShellState) -> ClientShellInput {
+    let deadline = state
+        .touch_press
+        .as_ref()
+        .expect("pending single tap")
+        .deadline;
+    let mut outcome = ClientShellInput::default();
+    state.tick_touch(deadline, &mut outcome);
+    outcome
+}
+
+#[test]
+fn double_tap_tabs_and_panes_matches_right_click_at_both_widths() {
+    for cols in [44, 106] {
+        for tab in [false, true] {
+            let mut state = touch_state(cols);
+            let rect = if tab && cols == 44 {
+                state.mode = ClientShellMode::Navigate;
+                state.compose(cols, 20).unwrap();
+                state
+                    .hits
+                    .mobile_targets
+                    .iter()
+                    .find_map(|(rect, target)| {
+                        matches!(target, ClientMobileTarget::Tab { .. }).then_some(*rect)
+                    })
+                    .unwrap()
+            } else if tab {
+                state.hits.tabs[0].0
+            } else {
+                state.hits.panes[0].inner_rect
+            };
+            let first = tap(&mut state, rect);
+            assert!(first.actions.is_empty() && first.requests.is_empty());
+            assert!(state.overlay.is_none());
+            let second = tap(&mut state, rect);
+            assert!(second.repaint);
+            assert!(second.actions.is_empty() && second.requests.is_empty());
+            assert!(state.selection.is_none());
+            let Some(ClientShellOverlay::ContextMenu(menu)) = state.overlay.take() else {
+                panic!("double tap should open context menu: {cols}, tab={tab}");
+            };
+            state.overlay = None;
+            state.handle_raw_events(vec![pointer(
+                MouseEventKind::Down(MouseButton::Right),
+                rect,
+            )]);
+            let Some(ClientShellOverlay::ContextMenu(right_menu)) = &state.overlay else {
+                panic!("right click should open context menu");
+            };
+            assert_eq!(
+                format!("{:?}", menu.target),
+                format!("{:?}", right_menu.target)
+            );
+            assert_eq!(
+                menu.items()
+                    .iter()
+                    .map(|item| item.label)
+                    .collect::<Vec<_>>(),
+                right_menu
+                    .items()
+                    .iter()
+                    .map(|item| item.label)
+                    .collect::<Vec<_>>()
+            );
+            assert!(!state.touch_right_button);
+        }
+    }
+}
+
+#[test]
+fn single_tab_tap_focuses_after_deadline_without_opening_menu() {
+    for cols in [44, 106] {
+        let mut state = touch_state(cols);
+        let rect = if cols == 44 {
+            state.mode = ClientShellMode::Navigate;
+            state.compose(cols, 20).unwrap();
+            state
+                .hits
+                .mobile_targets
+                .iter()
+                .find_map(|(rect, target)| {
+                    matches!(target, ClientMobileTarget::Tab { .. }).then_some(*rect)
+                })
+                .unwrap()
+        } else {
+            state.hits.tabs[0].0
+        };
+        tap(&mut state, rect);
+        let deadline = state.touch_press.as_ref().unwrap().deadline;
+        assert_eq!(state.timer_delay(deadline), std::time::Duration::ZERO);
+        let result = finish_single(&mut state);
+        assert!(state.overlay.is_none());
+        assert_eq!(state.mode, ClientShellMode::Terminal);
+        assert!(
+            matches!(&result.actions[..], [ClientShellAction::Endpoint { request, .. }]
+            if matches!(&request.method, crate::api::schema::Method::TabFocus(target) if target.tab_id == "tab_1"))
+        );
+    }
+}
+
+#[test]
+fn double_tap_passthrough_sends_only_complete_right_button_pair() {
+    let mut state = touch_state(106);
+    let mut projected = snapshot();
+    projected.panes[0].right_click_passthrough = true;
+    state.set_snapshot(Box::new(projected));
+    state.hits.panes[0].mouse_reporting = true;
+    let rect = state.hits.panes[0].inner_rect;
+    tap(&mut state, rect);
+    let result = tap(&mut state, rect);
+    assert!(state.overlay.is_none());
+    assert!(state.pane_mouse_gesture.is_none());
+    assert!(
+        matches!(&result.requests[..], [ClientMessage::ClientShellPaneInput { pane_id, events }]
+        if pane_id == "pane_1" && matches!(&events[..],
+            [ClientPaneInputEvent::Mouse { kind: crate::protocol::ClientMouseKind::Down(crate::protocol::ClientMouseButton::Right), .. },
+             ClientPaneInputEvent::Mouse { kind: crate::protocol::ClientMouseKind::Up(crate::protocol::ClientMouseButton::Right), .. }]))
+    );
+}
+
+#[test]
+fn single_tap_mouse_application_receives_both_left_reports() {
+    let mut state = touch_state(106);
+    state.hits.panes[0].mouse_reporting = true;
+    let rect = state.hits.panes[0].inner_rect;
+    tap(&mut state, rect);
+    let result = finish_single(&mut state);
+    assert!(state.pane_mouse_gesture.is_none());
+    assert!(
+        matches!(&result.requests[..], [ClientMessage::ClientShellPaneInput { events, .. }]
+        if matches!(&events[..],
+            [ClientPaneInputEvent::Mouse { kind: crate::protocol::ClientMouseKind::Down(crate::protocol::ClientMouseButton::Left), .. },
+             ClientPaneInputEvent::Mouse { kind: crate::protocol::ClientMouseKind::Up(crate::protocol::ClientMouseButton::Left), .. }]))
+    );
+}
+
+#[test]
+fn different_targets_or_distant_taps_do_not_open_a_menu() {
+    let mut state = touch_state(106);
+    let tab = state.hits.tabs[0].0;
+    let pane = state.hits.panes[0].inner_rect;
+    tap(&mut state, tab);
+    tap(&mut state, pane);
+    let distant = Rect::new(pane.x + 3, pane.y, 1, 1);
+    tap(&mut state, distant);
+    finish_single(&mut state);
+    assert!(state.overlay.is_none());
+}
+
+#[test]
+fn delayed_click_is_discarded_when_target_or_overlay_changes() {
+    for overlay in [false, true] {
+        let mut state = touch_state(106);
+        let rect = state.hits.tabs[0].0;
+        tap(&mut state, rect);
+        if overlay {
+            state.open_pane_context_menu("pane_1".into(), rect.x, rect.y);
+        } else {
+            state.hits.tabs[0].1 = "different-tab".into();
+        }
+        let result = finish_single(&mut state);
+        assert!(result.requests.is_empty() && result.actions.is_empty());
+    }
+}
+
+#[test]
+fn double_tap_menu_rename_targets_the_tapped_tab() {
+    let mut state = touch_state(106);
+    let rect = state.hits.tabs[0].0;
+    tap(&mut state, rect);
+    tap(&mut state, rect);
+    state.compose(106, 20).unwrap();
+    let rename = state
+        .hits
+        .context_menu_rows
+        .iter()
+        .find_map(|(rect, index)| (*index == 1).then_some(*rect))
+        .unwrap();
+    tap(&mut state, rename);
+    assert!(matches!(&state.overlay,
+        Some(ClientShellOverlay::Rename(ClientRenameOverlay { target: ClientRenameTarget::Tab { tab_id, .. }, .. }))
+            if tab_id == "tab_1"));
+}
+
+#[test]
+fn touch_tab_drag_still_reorders_and_does_not_open_menu() {
+    let mut state = touch_state(106);
+    let mut projected = snapshot();
+    let mut second = projected.tabs[0].clone();
+    second.tab_id = "tab_2".into();
+    second.focused = false;
+    projected.tabs.push(second);
+    state.set_snapshot(Box::new(projected));
+    state.compose(106, 20).unwrap();
+    let first = state.hits.tabs[0].0;
+    let last = state.hits.tabs[1].0;
+    let drop = Rect::new(last.right() - 1, last.y, 1, 1);
+    state.handle_raw_events(vec![pointer(
+        MouseEventKind::Down(MouseButton::Left),
+        first,
+    )]);
+    state.handle_raw_events(vec![pointer(MouseEventKind::Drag(MouseButton::Left), drop)]);
+    let result =
+        state.handle_raw_events(vec![pointer(MouseEventKind::Up(MouseButton::Left), drop)]);
+    assert!(state.overlay.is_none());
+    assert!(state.touch_press.is_none());
+    assert!(
+        matches!(&result.actions[..], [ClientShellAction::Endpoint { request, .. }]
+        if matches!(&request.method, crate::api::schema::Method::TabMove(target) if target.tab_id == "tab_1"))
+    );
+}
